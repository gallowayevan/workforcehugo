{{/* Search index consumed by /js/search.js, which renders matches as
     catalog entries client-side. Uses a local variable rather than
     .Scratch (Scratch persists across hugo-server rebuilds and would
     accumulate duplicates in local development). */}}
{{- $searchSections := .Site.Params.searchSections -}}
{{- $index := slice -}}
{{- range where (where .Site.RegularPages "Type" "in" $searchSections) ".Params.unlisted" "!=" true -}}
    {{- $date := "" -}}
    {{- if not .Date.IsZero }}{{ $date = dateFormat "2006.01.02" .Date }}{{ end -}}
    {{- $index = $index | append (dict "title" .Title "teaserText" .Params.teaserText "keywords" .Params.keywords "authors" .Params.author "section" .Section "date" $date "url" .RelPermalink) -}}
{{- end -}}
{{- $index | jsonify -}}
